{
  "name": "rednote-markdown-collector",
  "version": "0.4.1",
  "private": true,
  "license": "Apache-2.0",
  "author": "Hongjia LIN",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "benchmark:job": "vitest run --config vitest.stress.config.ts",
    "benchmark:ocr": "node scripts/benchmark-ocr.mjs",
    "benchmark:ocr:build": "vite build --config vite.benchmark.config.ts",
    "verify": "pnpm test && pnpm build && node scripts/verify-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "onnxruntime-web": "1.24.3"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "@types/node": "latest",
    "jsdom": "latest",
    "playwright-core": "1.62.0",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "packageManager": "pnpm@11.9.0"
}
