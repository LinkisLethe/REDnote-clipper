{
  "name": "rednote-markdown-collector",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "benchmark:dev": "vite --config vite.benchmark.config.ts",
    "benchmark:build": "tsc --noEmit -p tsconfig.benchmark.json && vite build --config vite.benchmark.config.ts",
    "benchmark:preview": "vite preview --config vite.benchmark.config.ts --host 127.0.0.1 --port 4173",
    "benchmark:start": "pnpm benchmark:build && pnpm benchmark:preview",
    "build": "tsc --noEmit && vite build",
    "verify": "pnpm test && pnpm build && node scripts/verify-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "onnxruntime-web": "1.24.3"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "@types/node": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "packageManager": "pnpm@11.9.0"
}
